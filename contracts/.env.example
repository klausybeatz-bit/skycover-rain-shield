# SkyCover contracts — environment template.
# Copy to `.env` and fill in. NEVER commit a real .env or a private key.

# Sepolia JSON-RPC endpoint. If unset, a public fallback is used.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/REPLACE_ME

# Deployer private key (0x-prefixed). Test-only key for Sepolia.
DEPLOYER_PRIVATE_KEY=

# Address authorized to submit rainfall reports (the backend oracle wallet).
ORACLE_ADDRESS=

# Optional seed liquidity sent to the contract at deployment, in whole ETH.
INITIAL_POOL_ETH=0

# Etherscan API key, used only by `npm run verify:sepolia`.
ETHERSCAN_API_KEY=

# Address of the deployed contract, used only by `npm run verify:sepolia`.
SKYCOVER_INSURANCE_ADDRESS=
