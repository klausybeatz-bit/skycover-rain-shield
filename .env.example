# ---------------------------------------------------------------------------
# SkyCover — UPI premium payments
#
# Copy this file to `.env` and fill in your own values. These are PLACEHOLDERS:
# nothing here is a working credential.
#
# Do NOT prefix any of these with VITE_. Vite inlines VITE_* variables into the
# browser bundle, which would leak the gateway secret to every visitor.
# ---------------------------------------------------------------------------

# Razorpay key id (publishable; it is passed to the gateway's own checkout).
# Example format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=

# Razorpay key secret. Server-side only — used to authenticate API calls and to
# verify the checkout signature. Never sent to the browser.
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret for the endpoint below. Server-side only.
# Razorpay Dashboard -> Settings -> Webhooks -> add
#   https://<your-domain>/api/upi/webhook
# then copy the secret it shows you.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Set to exactly "true" to force the simulated flow even when the
# three values above are present. Useful for demos and for CI.
# UPI_DEMO_MODE=true

# Optional. Fixed conversion used to price the INR premium from the ETH premium.
# This is a product configuration value, not a live exchange rate; the UI always
# shows the ETH premium next to the INR amount.
# UPI_INR_PER_ETH=250000
