# ---------------------------------------------------------------------------
# SkyCover — UPI premium payments
#
# Copy this file to `.env` and fill in your own values. These are PLACEHOLDERS:
# nothing here is a working credential.
#
# Do NOT prefix any of these with VITE_. Vite inlines VITE_* variables into the
# browser bundle, which would leak the gateway secret to every visitor.
# ---------------------------------------------------------------------------

# Razorpay key id (publishable; it is passed to the gateway's own checkout).
# Example format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=

# Razorpay key secret. Server-side only — used to authenticate API calls and to
# verify the checkout signature. Never sent to the browser.
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret for the endpoint below. Server-side only.
# Optional: live checkout works without it, because a settled payment is proved
# by the checkout signature and a Payments API read. Set it to also get the
# out-of-band confirmation channel (and reconciliation when a buyer closes the
# browser before the callback fires); until then /api/upi/webhook refuses every
# delivery rather than trusting a request it cannot verify.
# Razorpay Dashboard -> Settings -> Webhooks -> add
#   https://<your-domain>/api/upi/webhook
# then copy the secret it shows you.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Set to exactly "true" to force the simulated flow even when the key
# pair above is present. Useful for demos and for CI.
# UPI_DEMO_MODE=true

# Optional. Fixed conversion used to price the INR premium from the ETH premium.
# This is a product configuration value, not a live exchange rate; the UI always
# shows the ETH premium next to the INR amount.
# UPI_INR_PER_ETH=250000

# ---------------------------------------------------------------------------
# SkyCover — live data (TinyFish) and server-side oracle reporting
#
# Every variable below is SERVER-ONLY. On Cloudflare they are Worker secrets
# (`wrangler secret put <NAME>`); locally they go in `.env`, which is ignored
# by Git. Never prefix them with VITE_ — that inlines the value into the
# browser bundle — and never commit a real key.
# ---------------------------------------------------------------------------

# TinyFish API key, used to cross-check rainfall against IMD and to read live
# mandi prices (TinySearch + TinyFetch). Get one at:
#   https://agent.tinyfish.ai/api-keys
# Until this is set, the live-data sections report "not configured" — they do
# not fall back to fabricated values.
TINYFISH_API_KEY=

# Optional. SkyCover's own requests-per-minute budget for TinyFish calls
# (default 20).
# TINYFISH_RATE_LIMIT_PER_MINUTE=20

# Sepolia JSON-RPC endpoint used by the server-side oracle reporter. An RPC URL
# often embeds an API token, so treat it as a secret; only its host is ever
# printed by scripts.
SEPOLIA_RPC_URL=

# Private key of the account that is authorised on-chain as the contract's
# oracle. It must match the address the contract was deployed with (or a later
# `setOracle`). Required only for on-chain reporting. NEVER commit the real key.
ORACLE_PRIVATE_KEY=

# Deployed SkyCoverInsurance address on Sepolia. Required for on-chain oracle
# reports; when set it overrides CONTRACTS.insurance in src/lib/chain.ts.
SKYCOVER_INSURANCE_ADDRESS=
